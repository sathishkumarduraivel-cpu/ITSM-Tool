PORT=4000

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Required. Must be a 32-byte value, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt AI provider API keys and integration configs (webhook URLs, SMTP
# passwords, etc.) at rest. Losing/rotating this key makes existing encrypted
# secrets unreadable — re-enter them after rotating.
ENCRYPTION_KEY=

# Optional. When set, the seed creates the default OpenAI provider for Sona on a
# fresh database (stored encrypted with ENCRYPTION_KEY). OPENAI_MODEL defaults to
# gpt-4.1-mini. Never commit a real key -- this repo is public.
OPENAI_API_KEY=
OPENAI_MODEL=

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173

# Neon Postgres application connection (pooled). `neon deploy` writes this
# into the project-root .env.local; copy it here for local backend execution.
DATABASE_URL=

# Direct Neon URL for schema migrations, backups, and session-level admin work.
DATABASE_URL_UNPOOLED=
