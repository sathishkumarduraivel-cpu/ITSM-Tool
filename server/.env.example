PORT=4000

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Required. Must be a 32-byte value, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt AI provider API keys and integration configs (webhook URLs, SMTP
# passwords, etc.) at rest. Losing/rotating this key makes existing encrypted
# secrets unreadable — re-enter them after rotating.
ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN=http://localhost:5173
